# ==============================================================================
# Telegram Anonymous Platform Configuration
# ==============================================================================

# Telegram Bot API Token from @BotFather
BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz_EXAMPLE

# Bot username without @ (e.g. anonymous_confess_bot)
BOT_USERNAME=my_anonymous_bot

# Telegram Administrator User IDs (comma-separated integers)
ADMIN_IDS=123456789,987654321

# PostgreSQL Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=telegram_anonymous_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@postgres:5432/telegram_anonymous_db

# Redis Cache & Storage
REDIS_URL=redis://redis:6379/0

# Internal Cryptographic Secret Key (Used for secure operations)
SECRET_KEY=generate-a-32-character-random-secret-key-here-for-security

# Link Constraints
SLUG_MIN_LENGTH=3
SLUG_MAX_LENGTH=32
TOKEN_ENTROPY_BYTES=16

# Rate Limiting Defaults
RATE_LIMIT_MESSAGES_PER_MINUTE=10
RATE_LIMIT_MESSAGES_PER_HOUR=100
RATE_LIMIT_MESSAGES_PER_DAY=400
DUPLICATE_MESSAGE_COOLDOWN_SECONDS=15

# Content & Privacy Limits
MAX_MESSAGE_LENGTH=4000
MAX_NICKNAME_LENGTH=30
REPLY_TARGET_TTL_SECONDS=1800

# Environment / Logging
ENVIRONMENT=production
LOG_LEVEL=INFO
